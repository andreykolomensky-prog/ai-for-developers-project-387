{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "deny"
  },
  "agent": {
    "reviewer": {
      "description": "Независимый ревьюер pull request: читает код и обсуждение, сверяет со спецификацией, код не правит",
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "webfetch": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git status*": "allow",
          "git -C pr diff*": "allow",
          "git -C pr log*": "allow",
          "git -C pr show*": "allow",
          "git -C pr status*": "allow",
          "gh pr view*": "allow",
          "gh pr diff*": "allow",
          "gh pr checks*": "allow",
          "gh issue view*": "allow",
          "gh run view*": "allow",
          "gh run list*": "allow"
        }
      }
    }
  }
}
