{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "@testing-library/jest-dom/vitest"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["web/src/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Фронтенд обращается к API только через сгенерированный SDK из web/src/api/generated."
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist", "web/src/api/generated", "server/generated", ".claude/skills"]
}
